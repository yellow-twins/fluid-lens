#!/usr/bin/env php
<?php

declare(strict_types=1);

use Symfony\Component\Console\Application;
use YellowTwins\FluidLens\Command\AnalyzeCommand;
use YellowTwins\FluidLens\Command\ComponentsCommand;
use YellowTwins\FluidLens\Command\ConsistencyCommand;
use YellowTwins\FluidLens\Command\I18nCommand;
use YellowTwins\FluidLens\Command\LintCommand;
use YellowTwins\FluidLens\Command\ParseCommand;
use YellowTwins\FluidLens\Command\SimilarCommand;

(static function (): void {
    $autoloaders = [
        __DIR__ . '/../vendor/autoload.php',   // Standalone install of fluid-lens itself.
        __DIR__ . '/../../../autoload.php',     // Installed as a dependency inside another project.
    ];

    $loaded = false;
    foreach ($autoloaders as $autoloader) {
        if (is_file($autoloader)) {
            require $autoloader;
            $loaded = true;
            break;
        }
    }

    if ($loaded === false) {
        fwrite(STDERR, 'fluid-lens: could not locate the Composer autoloader. Run "composer install".' . PHP_EOL);
        exit(1);
    }

    $version = class_exists(\Composer\InstalledVersions::class)
        && \Composer\InstalledVersions::isInstalled('yellow-twins/fluid-lens')
        ? (string) \Composer\InstalledVersions::getPrettyVersion('yellow-twins/fluid-lens')
        : 'dev';

    $application = new Application('fluid-lens', $version);
    $application->add(new ParseCommand());
    $application->add(new AnalyzeCommand());
    $application->add(new SimilarCommand());
    $application->add(new LintCommand());
    $application->add(new ConsistencyCommand());
    $application->add(new ComponentsCommand());
    $application->add(new I18nCommand());
    $application->run();
})();
